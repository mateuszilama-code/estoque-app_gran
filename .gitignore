# ─────────────────────────────────────────────
# Dependências
# ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────
# Variáveis de ambiente (nunca versionar segredos)
# ─────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# obs.: versionar apenas .env.example (template sem segredos)
!.env.example

# ─────────────────────────────────────────────
# Banco de dados SQLite (gerado localmente)
# ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
database/*.sqlite

# ─────────────────────────────────────────────
# Builds / artefatos de compilação
# ─────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Logs e caches
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache

# ─────────────────────────────────────────────
# Sistema operacional / editores
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ─────────────────────────────────────────────
# Claude Code — configurações locais do usuário
# ─────────────────────────────────────────────
.claude/settings.local.json

# ─────────────────────────────────────────────
# Cobertura de testes
# ─────────────────────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────────────────────
# Documentação de etapas (docs/NN-*.md): registro local detalhado de cada
# etapa — NÃO versionado. Apenas a documentação viva (README.md,
# docs/00-visao-geral.md, docs/sdd.html) é enviada ao Git.
# ─────────────────────────────────────────────
docs/[0-9][0-9]-*.md
!docs/00-visao-geral.md

# ─────────────────────────────────────────────
# Material de apoio e arquivos de trabalho (não versionar)
#  - PDF da apostila: conteúdo licenciado, reprodução vedada
#  - roteiro de prompts: arquivo de trabalho interno, não é documentação viva
# ─────────────────────────────────────────────
*.pdf
prompts-claude-code-estoque.md

# ─────────────────────────────────────────────
# Configuração da API — copie para .env e ajuste conforme necessário
# ─────────────────────────────────────────────

# Porta HTTP em que a API sobe. Em produção, as plataformas de deploy
# (Render, Railway...) injetam esta variável automaticamente — não fixe o valor lá.
PORT=3000

# ─────────────────────────────────────────────
# Banco de dados
#
# A API funciona em dois modos, escolhidos automaticamente:
#
#   1. DATABASE_URL VAZIA  → SQLite em arquivo (padrão para desenvolvimento local).
#                            Usa DB_STORAGE abaixo. Não exige instalar nada.
#
#   2. DATABASE_URL PREENCHIDA → Postgres (usado no deploy). O disco das
#                            hospedagens gratuitas é apagado a cada restart,
#                            então um arquivo SQLite não sobreviveria lá.
#
# Deixe DATABASE_URL vazia na sua máquina para continuar usando SQLite.
# ─────────────────────────────────────────────

# Caminho do arquivo SQLite (relativo à raiz de apps/api). Ignorado se DATABASE_URL existir.
DB_STORAGE=./database/estoque.sqlite

# String de conexão Postgres do provedor (Neon, Netlify Database, Render...).
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────
# Origens permitidas por CORS (lista separada por vírgula). Vazio = libera todas
# (padrão, adequado ao MVP local). Em produção, informe a URL do frontend.
# Ex.: CORS_ORIGIN=https://fullstack-gran-mateusjacob.netlify.app
# ─────────────────────────────────────────────
CORS_ORIGIN=

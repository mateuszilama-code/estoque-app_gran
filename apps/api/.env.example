# ─────────────────────────────────────────────
# Configuração da API — copie para .env e ajuste conforme necessário
# ─────────────────────────────────────────────

# Porta HTTP em que a API sobe
PORT=3000

# Caminho do arquivo de banco SQLite (relativo à raiz de apps/api)
DB_STORAGE=./database/estoque.sqlite
